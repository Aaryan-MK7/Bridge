PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/bridge
FRONTEND_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_EXPIRES_IN=8h

# Optional notification settings
ADMIN_EMAIL=
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_USER_ID=

# Required only when running `npm run bootstrap:admin --workspace=server`
ADMIN_EMPLOYEE_ID=
ADMIN_NAME=
ADMIN_ACCOUNT_EMAIL=
ADMIN_PASSWORD=

# Optional DocuSign integration settings
DOCUSIGN_CLIENT_ID=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_REDIRECT_URI=http://localhost:4000/api/docusign/callback
DOCUSIGN_OAUTH_BASE=https://account-d.docusign.com
